{
  "name": "@jeftelabs/cli",
  "version": "1.1.0",
  "description": "Opinionated UI KIT for Command Line apps",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/examples",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js",
    "./helpers": "./build/src/helpers.js",
    "./types": "./build/src/types.js"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "npm run quick:test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "del-cli build",
    "typecheck": "tsc --noEmit",
    "precompile": "npm run lint && npm run clean",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "build": "npm run compile",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "quick:test": "node --import=@jeftelabs/exec --enable-source-maps bin/test.ts"
  },
  "devDependencies": {
    "@arapucajs/eslint-config": "^1.1.2",
    "@arapucajs/prettier": "^1.1.1",
    "@arapucajs/tsconfig": "^1.0.0",
    "@jeftelabs/exec": "^1.0.1",
    "@t8ngs/assert": "^1.0.0",
    "@t8ngs/runner": "^1.0.0",
    "@types/node": "^25.9.9",
    "@types/pretty-hrtime": "^1.0.3",
    "c8": "^10.1.3",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "del-cli": "^7.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "tsdown": "^0.21.5",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@jeftelabs/colors": "^1.0.0",
    "cli-boxes": "^4.0.1",
    "cli-table3": "^0.6.5",
    "cli-truncate": "^5.2.0",
    "log-update": "^7.2.0",
    "pretty-hrtime": "^1.0.3",
    "string-width": "^8.2.0",
    "supports-color": "^10.2.2",
    "terminal-size": "^4.0.1"
  },
  "homepage": "https://github.com/jeftelabs/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeftelabs/cli.git"
  },
  "bugs": {
    "url": "https://github.com/jeftelabs/cli/issues"
  },
  "keywords": [
    "cli",
    "ui",
    "kit",
    "command-line",
    "cli-kit",
    "cli-ui",
    "cli-tool",
    "cli-framework",
    "cli-components",
    "cli-kit-components",
    "cli-ui-components",
    "colors",
    "progress"
  ],
  "author": "Jefte Costa <jefteamorim@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./src/helpers.ts",
      "./src/types.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  },
  "prettier": "@arapucajs/prettier",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  }
}
